<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="printfarm"
      Manufacturer="v0l"
      Version="$(var.Version)"
      UpgradeCode="519101bd-1f77-4f19-ab41-af2e84a13314"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of printfarm is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="packaging\windows\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/v0l/printfarm" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="printfarm">
        <Component Id="AppExe" Guid="7d9654aa-4efd-469d-a649-9d484a3cef92">
          <File Id="PrintfarmExe" Source="$(var.BinDir)\printfarm.exe" KeyPath="yes" />
        </Component>
        <Component Id="AppDocs" Guid="c6a9b94d-7ae9-453c-b784-2e3b70a2d771">
          <File Id="ReadmeMd" Source="README.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcut" Guid="cf406091-6af7-4a8f-8967-d47536e79e4f">
        <Shortcut Id="PrintfarmShortcut" Icon="AppIcon" Name="printfarm" Target="[#PrintfarmExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\v0l\Printfarm" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="printfarm" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="AppDocs" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
  </Package>
</Wix>
